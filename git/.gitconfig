[user]
	name = Bastian Pedersen
[core]
	ignorecase = false
	editor = nvim
	pager = delta --features theme-$(defaults read -g AppleInterfaceStyle >/dev/null 2>&1 && echo dark || echo light)
[commit]
	gpgsign = false
[fetch]
	prune = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[rebase]
	autoStash = true
[blame]
	date = relative
[alias]
	l = log --pretty=format:\"%Cred%h%Creset %Cblue%ad%Creset %Cgreen%an%Creset %s\"
[interactive]
	diffFilter = delta --color-only --features theme-$(defaults read -g AppleInterfaceStyle >/dev/null 2>&1 && echo dark || echo light)
[delta]
	navigate = false
	true-color = always
[delta "catppuccin-latte"]
	light = true
	syntax-theme = Catppuccin Latte
[delta "catppuccin-mocha"]
	syntax-theme = Catppuccin Mocha
	commit-decoration-style = "#6c7086 bold box ul"
	dark = true
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086 box ul"
	hunk-header-file-style = bold
	hunk-header-line-number-style = "bold #a6adc8"
	hunk-header-style = file line-number syntax
	minus-emph-style = "bold syntax #694559"
	minus-style = "syntax #493447"
	plus-emph-style = "bold syntax #4e6356"
	plus-style = "syntax #394545"
	map-styles = "bold purple => syntax \"#5b4e74\", bold blue => syntax \"#445375\", bold cyan => syntax \"#446170\", bold yellow => syntax \"#6b635b\""
[delta "modus-operandi"]
	light = true
	syntax-theme = modus-operandi
	minus-style = syntax "#ffd8d5"
	minus-non-emph-style = syntax "#ffe9e9"
	minus-emph-style = syntax "#f3b5af"
	line-numbers-minus-style = "#8f1313"
	plus-style = syntax "#c1f2d1"
	plus-non-emph-style = syntax "#d8f8e1"
	plus-emph-style = syntax "#aee5be"
	line-numbers-plus-style = "#005000"
	line-numbers-zero-style = "#595959"
[delta "modus-vivendi"]
	dark = true
	syntax-theme = modus-vivendi
	minus-style = syntax "#4f1119"
	minus-non-emph-style = syntax "#380a0f"
	minus-emph-style = syntax "#781a1f"
	line-numbers-minus-style = "#ffbfbf"
	plus-style = syntax "#00381f"
	plus-non-emph-style = syntax "#002910"
	plus-emph-style = syntax "#034f2f"
	line-numbers-plus-style = "#a0e0a0"
	line-numbers-zero-style = "#989898"
# theme-light / theme-dark point at one of the variants above; see theme/theme
[include]
	path = ~/.config/theme/delta.gitconfig
[include]
	path = ~/.gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
