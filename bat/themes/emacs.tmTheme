<?xml version="1.0" encoding="UTF-8"?>
<!-- emacs: nvim-c's Emacs-style colours (nvim-c/colors/emacs.lua) for bat,
     used by its fzf previews. Few colours, no bold or italic. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>emacs</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#000000</string>
				<key>caret</key>
				<string>#d0d0d0</string>
				<key>foreground</key>
				<string>#d0d0d0</string>
				<key>gutterForeground</key>
				<string>#6c6c6c</string>
				<key>invisibles</key>
				<string>#4e4e4e</string>
				<key>lineHighlight</key>
				<string>#1c1c1c</string>
				<key>selection</key>
				<string>#2e3f6e</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#e07a3f</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string, constant.character, punctuation.definition.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#f0a080</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, keyword.operator.word, keyword.declaration, storage.modifier, storage.type.struct, storage.type.union, storage.type.enum, storage.type.typedef</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#3a9eff</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Operator</string>
			<key>scope</key>
			<string>keyword.operator, punctuation</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#d0d0d0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Type</string>
			<key>scope</key>
			<string>storage.type, support.type, entity.name.type</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#2ec4b0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Declared name</string>
			<key>scope</key>
			<string>variable.parameter, entity.name.constant, entity.name.macro, entity.name.enum, entity.name.struct, variable.other.member.declaration</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#2ec4b0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Function name</string>
			<key>scope</key>
			<string>entity.name.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#87cefa</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Preprocessor</string>
			<key>scope</key>
			<string>meta.preprocessor, keyword.control.import, keyword.control.directive, punctuation.definition.preprocessor, punctuation.definition.directive</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#b0c4de</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Macro name</string>
			<key>scope</key>
			<string>meta.preprocessor entity.name</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#2ec4b0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Plain</string>
			<key>scope</key>
			<string>constant.numeric, constant.language, support.function, support.constant, variable, variable.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#d0d0d0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Heading</string>
			<key>scope</key>
			<string>markup.heading, entity.name.section</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#3a9eff</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Inserted</string>
			<key>scope</key>
			<string>markup.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#2ec4b0</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Deleted</string>
			<key>scope</key>
			<string>markup.deleted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff5f5f</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Code</string>
			<key>scope</key>
			<string>markup.raw</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#f0a080</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
