#!/usr/bin/env bash
# Open a stripped-down console for writing C: the Commodore 64 font on Modus
# Vivendi black, a bare zsh prompt, plain BSD tools, strict C99 builds and a
# plugin-free Neovim (nvim-c).
#
#   cmode [--terminus] [dir]     dir defaults to the current one
set -euo pipefail

font=()
if [ "${1:-}" = "--terminus" ]; then
  font=(-o "font_family=family='Terminess Nerd Font Mono'" -o "font_size=15"
    -o "modify_font=cell_height 100%")
  shift
fi
dir="$(cd "${1:-.}" && pwd)"

kitty="$(command -v kitty || echo /Applications/kitty.app/Contents/MacOS/kitty)"
KITTY_CONFIG_DIRECTORY="$HOME/.config/kitty-cmode" nohup "$kitty" \
  --title cmode --directory "$dir" ${font[@]+"${font[@]}"} >/dev/null 2>&1 &
disown
