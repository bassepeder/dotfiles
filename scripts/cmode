#!/usr/bin/env bash
# Open a stripped-down console for writing C: Terminus on black, a bare zsh
# prompt, plain BSD tools, strict C99 builds and a plugin-free Neovim (nvim-c).
#
#   cmode [--c64] [dir]     dir defaults to the current one
set -euo pipefail

font=()
if [ "${1:-}" = "--c64" ]; then
  font=(-o "font_family=family='C64 Pro Mono'" -o "font_size=12"
    -o "symbol_map=U+E000-U+F8FF Symbols Nerd Font Mono" -o "modify_font=cell_height 125%")
  shift
fi
dir="$(cd "${1:-.}" && pwd)"

kitty="$(command -v kitty || echo /Applications/kitty.app/Contents/MacOS/kitty)"
KITTY_CONFIG_DIRECTORY="$HOME/.config/kitty-cmode" nohup "$kitty" \
  --title cmode --directory "$dir" "${font[@]}" >/dev/null 2>&1 &
disown
