#!/usr/bin/env bash
# Open a stripped-down console for writing C in Ghostty: the Commodore 64 font
# on black, a CRT pass, a bare zsh prompt, plain BSD tools, strict C99 builds
# and a plugin-free Neovim (nvim-c).
#
#   cmode [--no-crt] [--no-c64] [dir]
#   cmode font [id]       inside a cmode window: switch its font, or show it
#
#   --no-crt     without the CRT pass, which recreates the cool-retro-term
#                profile in cool_retro_term.json (--crt turns it back on)
#   --no-c64     your usual font (`theme font`) instead of the Commodore 64 one
#                (--c64 turns it back on)
#   dir          where to start; defaults to the current directory
#
# Fonts are the ones from `theme fonts`. Each window gets its own font file,
# so `cmode font` (or :Font in nvim-c) only changes that window.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEME="$DOTFILES/theme/theme"

usage() { sed -n '6,16p' "$0" | sed 's/^# \{0,1\}//'; }
die() {
  echo "cmode: $*" >&2
  exit 1
}

write_font() { # id, file
  local spec
  spec="$("$THEME" font-spec "$1" ghostty 2>/dev/null)" || die "unknown font: $1 (see: theme fonts)"
  printf '# font: %s\n%s\n' "$1" "$spec" >"$2"
}

# the Ghostty process this shell runs in
own_ghostty() {
  local pid=$$
  while [ "$pid" -gt 1 ]; do
    [ "$(basename "$(ps -o comm= -p "$pid")")" = ghostty ] && echo "$pid" && return
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
  done
  return 1
}

font_cmd() {
  [ -n "${CMODE_FONT_FILE:-}" ] || die "\`cmode font\` only works inside a cmode window"
  if [ -z "${1:-}" ]; then
    sed -n 's/^# font: //p' "$CMODE_FONT_FILE"
    return
  fi
  write_font "$1" "$CMODE_FONT_FILE"
  # each cmode window is its own Ghostty; SIGUSR2 makes just that one reload
  # its config. (AppleScript can't do this: whatever PID it's given, it talks
  # to the first Ghostty that was started.)
  local pid
  pid="$(own_ghostty)" || die "can't find this window's Ghostty"
  kill -USR2 "$pid"
}

if [ "${1:-}" = font ]; then
  font_cmd "${2:-}"
  exit
fi

crt=1
font=c64
while [ $# -gt 0 ]; do
  case "$1" in
  --crt) crt=1 ;;
  --no-crt) crt=0 ;;
  --c64) font=c64 ;;
  --no-c64) font="$("$THEME" font)" ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    echo "cmode: unknown option $1" >&2
    usage >&2
    exit 1
    ;;
  *) break ;;
  esac
  shift
done
dir="$(cd "${1:-.}" && pwd)"

state="${TMPDIR:-/tmp}/cmode"
mkdir -p "$state"
font_file="$(mktemp "$state/font.XXXXXX")"
write_font "$font" "$font_file"

# Ghostty reads config files after the command line, so per-window settings
# go in files loaded after the main one
session="$(mktemp "$state/session.XXXXXX")"
echo "command = /usr/bin/env CMODE=1 CMODE_FONT_FILE=$font_file /bin/zsh -l" >"$session"
# custom-shader is a list; an empty value clears the CRT pass
[ "$crt" = 1 ] || echo "custom-shader =" >>"$session"
# -n: a separate Ghostty instance, so its config doesn't touch other windows
open -na Ghostty --args --config-default-files=false \
  --config-file="$HOME/.config/ghostty-cmode/config" \
  --config-file="$font_file" --config-file="$session" --working-directory="$dir"
