alt - e : yabai -m window --toggle split
alt - r : yabai -m space --rotate 90
alt - t : yabai -m window --toggle float

alt - d : yabai -m window --toggle zoom-parent
alt - f : yabai -m window --toggle zoom-fullscreen

alt - w : yabai -m window --close

alt - h : yabai -m window --focus west || yabai -m window --focus stack.prev || yabai -m window --focus stack.last
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east || yabai -m window --focus stack.next || yabai -m window --focus stack.first

alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

alt + ctrl - h : yabai -m window --warp west
alt + ctrl - j : yabai -m window --warp south
alt + ctrl - k : yabai -m window --warp north
alt + ctrl - l : yabai -m window --warp east

alt + shift - 1 : id=$(yabai -m query --windows --window | jq .id); yabai -m window --space 1 && yabai -m space --focus 1 && yabai -m window --focus $id
alt + shift - 2 : id=$(yabai -m query --windows --window | jq .id); yabai -m window --space 2 && yabai -m space --focus 2 && yabai -m window --focus $id
alt + shift - 3 : id=$(yabai -m query --windows --window | jq .id); yabai -m window --space 3 && yabai -m space --focus 3 && yabai -m window --focus $id
alt + shift - 4 : id=$(yabai -m query --windows --window | jq .id); yabai -m window --space 4 && yabai -m space --focus 4 && yabai -m window --focus $id
alt + shift - 5 : id=$(yabai -m query --windows --window | jq .id); yabai -m window --space 5 && yabai -m space --focus 5 && yabai -m window --focus $id

meh - w : yabai -m space --focus 3;
meh - r : yabai -m space --focus 2;
# open spotlight from an iOS remote session
meh - t : skhd -k "cmd - space"

meh - a : yabai -m window --focus "$(yabai -m query --windows | jq 'first(.[] | select(.app  == "Audio Hijack") | .id)')"
meh - s : yabai -m space --focus 1;
meh - d : yabai -m window --focus "$(yabai -m query --windows | jq 'first(.[] | select(.app  == "Discord PTB") | .id)')"

meh - v : yabai -m space --focus 4;
meh - m : yabai -m window --focus "$(yabai -m query --windows | jq 'first(.[] | select(.app  == "Music") | .id)')"
meh - e : yabai -m space --focus 5; yabai -m window --focus "$(yabai -m query --windows | jq 'first(.[] | select(.app  == "Superhuman") | .id)')"

# block macOS opening mail client
cmd - i : ls

