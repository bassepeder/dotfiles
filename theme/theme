#!/usr/bin/env bash
# One theme and font for kitty, Neovim/Neovide, delta, lazygit, bat and btop.
#
#   theme                         show the current setting
#   theme set <family> [mode]     family: catppuccin | modus
#                                 mode:   system (default) | light | dark
#   theme font [id]               switch font (kitty + Neovide), or show it
#   theme fonts                   list fonts as id|label|neovide guifont|size
#   theme font-spec <id> <kitty|ghostty>
#                                 print a font's config lines (used by cmode)
#   theme variant [light|dark]    variant id for a slot, or the active one
#   theme apply                   regenerate the per-tool files from the state
#
# In Neovim, :Theme and :Font open pickers for the same settings.
#
# Every tool has a light and a dark slot that it picks between by the macOS
# appearance. "system" fills them with the family's light/dark variants; a
# fixed mode puts the same variant in both, so the tool's own switching
# becomes a no-op. Neovim reads the state file itself (lua/config/theme.lua).
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DOTFILES="$(dirname "$DIR")"
STATE="$DIR/state"

# id|label|kitty font_family|Neovide guifont (comma = fallbacks)|size|extra kitty lines (; separated)
# C64 Pro Mono keeps PETSCII in the private use area where Nerd Font icons
# live, so map that range back to the icons, and give its full-height glyphs
# some room between lines.
FONTS="\
jetbrains|JetBrains Mono|family='JetBrainsMono Nerd Font Mono' style=Light variable_name=JetBrainsMonoNerdFontMono|JetBrainsMono Nerd Font Mono|13|
fira|Fira Code|family='FiraCode Nerd Font Mono'|FiraCode Nerd Font Mono|13|
terminus|Terminus|family='Terminess Nerd Font Mono'|Terminess Nerd Font Mono|15|
c64|Commodore 64|family='C64 Pro Mono'|Symbols Nerd Font Mono,C64 Pro Mono|12|symbol_map U+E000-U+F8FF Symbols Nerd Font Mono;modify_font cell_height 125%"

family=catppuccin
mode=system
font=jetbrains
if [ -f "$STATE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
    family) family="$v" ;;
    mode) mode="$v" ;;
    font) font="$v" ;;
    esac
  done <"$STATE"
fi

save() {
  printf 'family=%s\nmode=%s\nfont=%s\n' "$family" "$mode" "$font" >"$STATE"
}

variant_for() { # family, light|dark
  case "$1:$2" in
  catppuccin:light) echo catppuccin-latte ;;
  catppuccin:dark) echo catppuccin-mocha ;;
  modus:light) echo modus-operandi ;;
  modus:dark) echo modus-vivendi ;;
  *) return 1 ;;
  esac
}

system_appearance() {
  defaults read -g AppleInterfaceStyle &>/dev/null && echo dark || echo light
}

slot() { # light|dark -> variant shown in that slot
  if [ "$mode" = system ]; then variant_for "$family" "$1"; else variant_for "$family" "$mode"; fi
}

bat_name() {
  case "$1" in
  catppuccin-latte) echo "Catppuccin Latte" ;;
  catppuccin-mocha) echo "Catppuccin Mocha" ;;
  *) echo "$1" ;; # modus-* tmThemes are named after their file
  esac
}

font_field() { # id, field number -> field (fails for unknown ids)
  awk -F'|' -v id="$1" -v n="$2" '$1 == id { print $n; found = 1 } END { exit !found }' <<<"$FONTS"
}

# A font's settings as kitty or Ghostty config lines. Both reset what another
# font may have set before, so the lines can replace any earlier font.
font_spec() { # id, kitty|ghostty
  local family size extra name style
  family="$(font_field "$1" 3)" || return 1
  size="$(font_field "$1" 5)"
  extra="$(font_field "$1" 6)"
  case "$2" in
  kitty)
    printf 'font_family %s\nfont_size %s\nmodify_font cell_height 100%%\n' "$family" "$size"
    tr ';' '\n' <<<"$extra" | sed '/^$/d'
    ;;
  ghostty)
    name="$(sed -E "s/.*family='([^']*)'.*/\1/" <<<"$family")"
    style="$(sed -nE 's/.*style=([^ ]+).*/\1/p' <<<"$family")"
    # font-family is a fallback list; "" clears it
    printf 'font-family = ""\nfont-family = %s\nfont-style = %s\nfont-size = %s\nadjust-cell-height = 0%%\n' \
      "$name" "${style:-default}" "$size"
    tr ';' '\n' <<<"$extra" | sed -nE \
      -e 's/^symbol_map ([^ ]+) (.*)$/font-codepoint-map = \1=\2/p' \
      -e 's/^modify_font cell_height ([0-9]+)%$/adjust-cell-height = \1%/p' |
      awk '/^adjust-cell-height/ { sub(/= /, ""); split($0, a, " "); printf "adjust-cell-height = %d%%\n", a[2] - 100; next } { print }'
    ;;
  *) return 1 ;;
  esac
}

reload_kitty() {
  pkill -USR1 -x kitty 2>/dev/null || true
}

apply() {
  local light dark
  light="$(slot light)"
  dark="$(slot dark)"

  # kitty swaps between these on appearance changes
  echo "include $light.conf" >"$DOTFILES/kitty/light-theme.auto.conf"
  echo "include $dark.conf" >"$DOTFILES/kitty/dark-theme.auto.conf"
  {
    printf 'font_family %s\nfont_size %s\n' "$(font_field "$font" 3)" "$(font_field "$font" 5)"
    font_field "$font" 6 | tr ';' '\n'
  } >"$DOTFILES/kitty/font.conf"

  # git/lazygit pick theme-light or theme-dark; each is an alias for a variant feature
  cat >"$DIR/delta.gitconfig" <<GIT
# generated by theme/theme, do not edit
[delta "theme-light"]
	features = $light
[delta "theme-dark"]
	features = $dark
GIT

  # bat asks the terminal whether it's light or dark; where it can't (fzf
  # previews, pipes) auto:system falls back to the macOS appearance instead of
  # bat's built-in Monokai
  printf -- '--theme=auto:system\n--theme-light="%s"\n--theme-dark="%s"\n' \
    "$(bat_name "$light")" "$(bat_name "$dark")" >"$DOTFILES/bat/config"
  # rebuild bat's theme cache when a theme in bat/themes isn't in it yet
  if command -v bat >/dev/null; then
    local cached
    cached="$(bat --list-themes --color=never 2>/dev/null)"
    for t in "$DOTFILES"/bat/themes/*.tmTheme; do
      if ! grep -qx "$(basename "$t" .tmTheme)" <<<"$cached"; then
        bat cache --build >/dev/null
        break
      fi
    done
  fi

  reload_kitty
}

case "${1:-}" in
"")
  echo "family=$family mode=$mode ($(variant_for "$family" "$([ "$mode" = system ] && system_appearance || echo "$mode")")) font=$font"
  ;;
set)
  new_family="${2:?usage: theme set <catppuccin|modus> [system|light|dark]}"
  new_mode="${3:-system}"
  variant_for "$new_family" light >/dev/null || { echo "unknown family: $new_family" >&2; exit 1; }
  case "$new_mode" in system | light | dark) ;; *) echo "unknown mode: $new_mode" >&2; exit 1 ;; esac
  family="$new_family" mode="$new_mode"
  save
  apply
  ;;
font)
  if [ -z "${2:-}" ]; then
    echo "$font"
    exit 0
  fi
  font_field "$2" 1 >/dev/null || { echo "unknown font: $2 (see: theme fonts)" >&2; exit 1; }
  font="$2"
  save
  apply
  ;;
fonts)
  awk -F'|' '{ print $1 "|" $2 "|" $4 "|" $5 }' <<<"$FONTS"
  ;;
font-spec)
  font_spec "${2:?usage: theme font-spec <id> <kitty|ghostty>}" "${3:-}" ||
    { echo "theme: unknown font or terminal: ${2} ${3:-}" >&2; exit 1; }
  ;;
variant)
  slot "${2:-$(system_appearance)}"
  ;;
apply) apply ;;
*)
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 1
  ;;
esac
