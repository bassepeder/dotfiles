#!/usr/bin/env sh

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# global settings
yabai -m config mouse_follows_focus on
yabai -m config window_placement second_child
yabai -m config window_opacity on
yabai -m config window_shadow on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.90
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_animation_duration 0.15
yabai -m config window_animation_easing ease_out_quint

# general space settings
yabai -m config layout bsp
yabai -m config top_padding 8
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 12

#space 1: browser
yabai -m rule --add app="Vivaldi" space=^1
yabai -m rule --add app="Firefox" space=^1
yabai -m rule --add app="Brave" space=^1

#space 2: terminal
yabai -m rule --add app="Ghostty" space=^2
yabai -m rule --add app="kitty" space=^2
yabai -m rule --add app="Things" space=^2

# space 3: dev
yabai -m rule --add app="JetBrains Rider*" space=^3

# space 4: dev
yabai -m rule --add app="WebStorm-*" space=^4

# things which create floating children
yabai -m rule --add title="JetBrains Toolbox" manage=off mouse_follows_focus=off
yabai -m rule --add title="Audio Hijack Session List" manage=off mouse_follows_focus=off
yabai -m rule --add title="Settings" manage=off mouse_follows_focus=off     # every JetBrains product settings
yabai -m rule --add title="Raycast Settings" manage=off mouse_follows_focus=off
yabai -m rule --add title="Leauge of Legends" manage=off
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="Stats" manage=off
yabai -m rule --add app="About This Mac" manage=off mouse_follows_focus=off
yabai -m rule --add app="System Information" manage=off mouse_follows_focus=off
yabai -m rule --add app="^Simulator" manage=off

pkill -x borders 2>/dev/null || true
"$HOME/.config/borders/bordersrc" &

[ -f ~/.yabairc.local ] && . ~/.yabairc.local
